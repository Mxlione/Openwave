.coverage
coverage.xml
htmlcov/

# OpenWave signal captures (large binary files, never commit)
#
# Not a bare "*.ts": that was here for MPEG transport streams, and it silently excluded every
# TypeScript file in the Angular interface from a commit that claimed to add it. Transport
# stream captures go in captures/, which is ignored wholesale, and the unambiguous extensions
# are listed instead.
captures/
*.cf32
*.iq
*.sigmf-data
*.mpegts
*.m2ts

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/

# The built interface, copied here by the release workflow so a wheel carries it. It is build
# output, never a source: a checkout has no such directory and the API falls back to
# frontend/dist.
src/openwave/interface/

# Docs build
site/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
